<?php

/**
 * @file
 * cheeta_subtheme theme file.
 */

function cheeta_theme_preprocess_paragraph(&$variables) {
  if ($variables['paragraph']->bundle() === 'image_and_text_component') {
    $boolean_field = $variables['paragraph']->get('field_image_alignment')->value;
    $variables['text_position'] = (bool) $boolean_field;
  }
}
