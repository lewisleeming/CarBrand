{
    "name": "zoocha/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Zoocha",
    "support": {
        "docs": "https://github.com/Zoocha/TBC",
        "chat": "https://github.com/Zoocha/TBC"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.4",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/bootstrap5": "^4.0",
        "drupal/captcha": "^2.0",
        "drupal/clamav": "^2.0",
        "drupal/config_ignore": "^3.2",
        "drupal/config_split": "^2.0",
        "drupal/content_lock": "^2.3",
        "drupal/core-composer-scaffold": "^10.2",
        "drupal/core-project-message": "^10.2",
        "drupal/core-recommended": "^10.2",
        "drupal/crop": "^2.3",
        "drupal/eu_cookie_compliance": "^1.24",
        "drupal/extlink": "^1.7",
        "drupal/facets": "^2.0",
        "drupal/field_group": "^3.4",
        "drupal/flood_control": "^2.3",
        "drupal/gin": "^3.0@rc",
        "drupal/gin_toolbar": "^1.0@rc",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.1",
        "drupal/link_class": "^2.1",
        "drupal/linkit": "^6.1",
        "drupal/memcache": "^2.5",
        "drupal/menu_block": "^1.10",
        "drupal/metatag": "^2.0",
        "drupal/paragraphs": "^1.17",
        "drupal/password_policy": "^4.0",
        "drupal/pathauto": "^1.12",
        "drupal/purge": "^3.5",
        "drupal/recaptcha": "^3.2",
        "drupal/recaptcha_v3": "^2.0",
        "drupal/redirect": "^1.9",
        "drupal/reroute_email": "^2.2",
        "drupal/search_api_autocomplete": "^1.8",
        "drupal/search_api_solr": "^4.3",
        "drupal/seckit": "^2.0",
        "drupal/smtp": "^1.2",
        "drupal/svg_image": "^3.0",
        "drupal/username_enumeration_prevention": "^1.3",
        "drupal/webform": "^6.2",
        "drupal/xmlsitemap": "^1.5",
        "drush/drush": "^12.4.3"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
